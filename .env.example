# Copy this file to ".env.local" for local dev, and set the same
# variables in the Vercel dashboard for production.

# REQUIRED — free key from https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here

# OPTIONAL — any random string; makes hidden game answers unguessable
SECRET_SEED=change-me-to-something-random

# OPTIONAL — override models (defaults are fine)
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_FAST_MODEL=llama-3.1-8b-instant
